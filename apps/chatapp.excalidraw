    {
      "id": "ae_mKOdAejDorr58ytpqh",
      "type": "text",
      "x": 52.68572998046875,
      "y": 616.3128662109375,
      "width": 578.2799682617188,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1754228246,
      "version": 240,
      "versionNonce": 428816330,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792679384946,
      "created": 1792678857823,
      "link": null,
      "locked": false,
      "text": "Requirments\n- Support login use OAUTH and support Google, Apple login\n- Support chat list and not sort\n- Support room chat with realtime chat\n- Support typing in realtime.\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirments\n- Support login use OAUTH and support Google, Apple login\n- Support chat list and not sort\n- Support room chat with realtime chat\n- Support typing in realtime.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zgOkQI30dTQIn0z8iaS91",
      "type": "text",
      "x": 50,
      "y": 773.855712890625,
      "width": 800,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1489179658,
      "version": 356,
      "versionNonce": 619826314,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792679483890,
      "created": 1792679388259,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n- login with OAuth use Vercel, firebase. Cache store the session that could be\nreuse.\n- Fetch chat list without the order.\n- Enter room chat with realtime message. \n- Cache the message for reuse and faster room message load",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n- login with OAuth use Vercel, firebase. Cache store the session that could be reuse.\n- Fetch chat list without the order.\n- Enter room chat with realtime message. \n- Cache the message for reuse and faster room message load",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
