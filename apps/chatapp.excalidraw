      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 1554503818,
      "version": 598,
      "versionNonce": 483227018,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792679924832,
      "created": 1792679536306,
      "link": null,
      "locked": false,
      "text": "DataModel\nUser:\n- id: UUID\n- token: String\n- email: String\n- displayName: String\n- avatarUrl: String\n\nChatRoom:\n- roomId: UUID\n- roomName: String\n- roomType: Enum\n- participantIds: [UUID]\n- lastMessage: \n  - text: String\n  - senderId: String\n  - timestamp: Timestamp\n- unreadCount: Int\n- updatedAt: Timestamp\n\nMessage:\n- messageId: UUID\n- roomId: UUID\n- senderId: UUID\n- text: String\n- mediaURL: String\n- status: Enum\n- timestamp: Timestamp",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DataModel\nUser:\n- id: UUID\n- token: String\n- email: String\n- displayName: String\n- avatarUrl: String\n\nChatRoom:\n- roomId: UUID\n- roomName: String\n- roomType: Enum\n- participantIds: [UUID]\n- lastMessage: \n  - text: String\n  - senderId: String\n  - timestamp: Timestamp\n- unreadCount: Int\n- updatedAt: Timestamp\n\nMessage:\n- messageId: UUID\n- roomId: UUID\n- senderId: UUID\n- text: String\n- mediaURL: String\n- status: Enum\n- timestamp: Timestamp",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KB_oPPZsEtqFDd4foTZxO",
      "type": "text",
      "x": 736,
      "y": 972.965576171875,
      "width": 520.47998046875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 660416970,
      "version": 209,
      "versionNonce": 1887112726,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792680101125,
      "created": 1792679936130,
      "link": null,
      "locked": false,
      "text": "APIs:\n- POST: chat/v1/login -> handle by 3rd lib like OAuth\n- GET: chat/v1/all\n- GET: chat/v1/{roomId}/messages?cursor={}\n- POST: chat/v1/{roomId}/sent",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\n- POST: chat/v1/login -> handle by 3rd lib like OAuth\n- GET: chat/v1/all\n- GET: chat/v1/{roomId}/messages?cursor={}\n- POST: chat/v1/{roomId}/sent",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "z8iQDwQNK2ZB_FtNIxnHw",
      "type": "text",
      "x": 734.54296875,
      "y": 1117.05126953125,
      "width": 776.1600952148438,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 1434284682,
      "version": 562,
      "versionNonce": 1360430678,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792680670849,
      "created": 1792680435232,
      "link": null,
      "locked": false,
      "text": "Web Socket:\n- Stream: chat/v1/ws?token={}\n  - Client -> server\n    - room:subscribe -> payload: { roomId }\n    - room:unsubscribe -> payload: { roomId }\n    - typing:update -> payload: { roomId, isTyping }\n\n  - Server -> Client\n    - message:new -> payload: Full message object\n    - room:update -> payload: { roomId, lastMessage, unreadCount, updatedAt }\n    - typing:broadcast -> payload: { roomId, senderId, isTyping }\n    ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Web Socket:\n- Stream: chat/v1/ws?token={}\n  - Client -> server\n    - room:subscribe -> payload: { roomId }\n    - room:unsubscribe -> payload: { roomId }\n    - typing:update -> payload: { roomId, isTyping }\n\n  - Server -> Client\n    - message:new -> payload: Full message object\n    - room:update -> payload: { roomId, lastMessage, unreadCount, updatedAt }\n    - typing:broadcast -> payload: { roomId, senderId, isTyping }\n    ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
